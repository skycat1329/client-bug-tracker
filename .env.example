# ==============================================================================
# Client Bug Tracker - Production Environment Configuration
# ==============================================================================

PORT=4000
NODE_ENV=production
APP_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# Database (Self-hosted SQLite via @libsql/client - zero external db required)
DATABASE_URL=file:local.db

# JWT Security (Generate a random 32+ character string)
JWT_SECRET=production_secret_key_antigravity_replace_with_random_string
JWT_EXPIRES_IN=7d

# Slack Webhook Integration (Optional, leave blank if not yet configured)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_BUG_REPORTS=#client-bug-reports
SLACK_CHANNEL_DEV_TRIAGE=#dev-triage
SLACK_CHANNEL_INCIDENTS=#production-incidents
SLACK_CHANNEL_RESOLUTIONS=#ticket-resolutions

# Email Notifications (Options: 'logger' for safe logging, 'smtp', or 'resend')
EMAIL_PROVIDER=logger
EMAIL_FROM=support@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# File Uploads Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,application/pdf,text/plain
