# ==============================================================================
# Client Bug Tracker - Backend Environment Configuration
# ==============================================================================

PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database configuration
DATABASE_URL=file:local.db

# Authentication
JWT_SECRET=super_secret_jwt_signing_key_for_development_replace_in_production
JWT_EXPIRES_IN=7d

# Slack Webhook Integration
# Leave empty for safe local mode or insert your webhook to test
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_BUG_REPORTS=#client-bug-reports
SLACK_CHANNEL_DEV_TRIAGE=#dev-triage
SLACK_CHANNEL_INCIDENTS=#production-incidents
SLACK_CHANNEL_RESOLUTIONS=#ticket-resolutions

# Email Notifications
EMAIL_PROVIDER=logger
EMAIL_FROM=support@webagency.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,application/pdf,text/plain
